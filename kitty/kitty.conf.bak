# Font
font_family      JetBrainsMono Nerd Font
font_size       9.0

allow_remote_control yes
# background #ffc0cb 
# Transparency
background_opacity 0.9
dynamic_background_opacity yes

# Window
window_padding_width 10
hide_window_decorations yes
confirm_os_window_close 0

# Cursor
cursor_shape beam
cursor_blink_interval 0

# Scrollback and behavior
scrollback_lines 10000
enable_audio_bell no
copy_on_select clipboard

# Tabs (only show when you have more than one)
tab_bar_style powerline
tab_bar_min_tabs 2

# Shortcuts
map ctrl+shift+equal change_font_size all +1.0
map ctrl+shift+minus change_font_size all -1.0
map ctrl+shift+backspace change_font_size all 0
map ctrl+shift+o change_background_opacity +0.05
map ctrl+shift+l change_background_opacity -0.05

# Theme (added by kitten themes, or paste your own below)









# BEGIN_KITTY_THEME
# Cobalt Neon
include current-theme.conf
# END_KITTY_THEME
